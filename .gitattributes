* text=auto

# Keep every repository text artifact byte-stable across operating systems.
.gitattributes text eol=lf
.gitignore text eol=lf
.gitkeep text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ps1 text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# This legacy manifest was historically frozen and referenced by the hash of
# its Windows working-tree bytes. Preserve those exact bytes across clones.
registry/manifests/mendeley_investment_deceptive_2026__v2__2026-09-07.json -text !eol

# Never apply newline conversion to binary research artifacts.
*.bin -text
*.gif -text
*.jpeg -text
*.jpg -text
*.parquet -text
*.pdf -text
*.pkl -text
*.png -text
*.pt -text
*.safetensors -text
*.xlsx -text
*.zip -text
