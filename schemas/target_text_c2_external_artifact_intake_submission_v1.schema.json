{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.isi.example/schemas/target_text_c2_external_artifact_intake_submission_v1.schema.json",
  "title": "Target Text Corpus V1 C2 external artifact and rights intake submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["submission_id", "protocol_id", "status", "created_at", "prepared_by", "items"],
  "properties": {
    "submission_id": {"type": "string", "minLength": 1},
    "protocol_id": {"const": "ISI_TARGET_TEXT_CORPUS_V1_C2_EXTERNAL_ARTIFACT_INTAKE_PROTOCOL_V1"},
    "status": {"const": "PENDING_INDEPENDENT_C2_INTAKE_QA"},
    "created_at": {"type": "string", "format": "date-time"},
    "prepared_by": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "item_type",
          "source_id",
          "official_source_url",
          "acquisition_mode",
          "acquired_at",
          "original_filename",
          "stored_relative_path",
          "media_type",
          "byte_size",
          "sha256",
          "rights_basis",
          "prerequisite_rights_registry_path",
          "redistribution_permitted",
          "contains_personal_data",
          "notes"
        ],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "item_type": {"enum": ["SOURCE_ARTIFACT", "RIGHTS_EVIDENCE_RECORD"]},
          "source_id": {
            "enum": [
              "cftc_red_list",
              "dfpi_crypto_scam_tracker",
              "ssc_vietnam_investor_warnings",
              "hnx_vietnam_issuer_profiles"
            ]
          },
          "official_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "acquisition_mode": {
            "enum": [
              "USER_SUPPLIED_UNTOUCHED_ARTIFACT",
              "USER_SAVED_FIRST_PARTY_ARTIFACT",
              "EXPLICIT_OFFICIAL_EXPORT",
              "OFFICIAL_TERMS_RECORD",
              "WRITTEN_PERMISSION"
            ]
          },
          "acquired_at": {"type": "string", "format": "date-time"},
          "original_filename": {"type": "string", "minLength": 1},
          "stored_relative_path": {"type": "string", "minLength": 3},
          "media_type": {"type": "string", "minLength": 3},
          "byte_size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rights_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis_type", "terms_or_permission_url", "summary"],
            "properties": {
              "basis_type": {
                "enum": [
                  "FIRST_PARTY_PUBLIC_RECORD_INTERNAL_RESEARCH",
                  "EXPLICIT_OFFICIAL_EXPORT_TERMS",
                  "OFFICIAL_PUBLIC_TERMS",
                  "WRITTEN_PERMISSION"
                ]
              },
              "terms_or_permission_url": {"type": ["string", "null"]},
              "summary": {"type": "string", "minLength": 1}
            }
          },
          "prerequisite_rights_registry_path": {"type": ["string", "null"]},
          "redistribution_permitted": {"const": false},
          "contains_personal_data": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
