{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.isi.example/schemas/target_text_manual_acquisition_submission_v1.schema.json",
  "title": "Target Text Corpus V1 manual acquisition submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["submission_id", "packet_id", "status", "created_at", "prepared_by", "items"],
  "properties": {
    "submission_id": {"type": "string", "minLength": 1},
    "packet_id": {"const": "ISI_TARGET_TEXT_CORPUS_V1_MANUAL_ACQUISITION_PACKET_V1"},
    "status": {"const": "PENDING_INDEPENDENT_INTAKE_QA"},
    "created_at": {"type": "string", "format": "date-time"},
    "prepared_by": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id", "source_id", "official_source_url", "acquisition_mode",
          "acquired_at", "original_filename", "stored_relative_path", "media_type",
          "byte_size", "sha256", "rights_basis", "redistribution_permitted",
          "contains_personal_data", "notes"
        ],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "source_id": {
            "enum": [
              "dfpi_crypto_scam_tracker",
              "ssc_vietnam_investor_warnings",
              "hnx_vietnam_issuer_profiles"
            ]
          },
          "official_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "acquisition_mode": {
            "enum": [
              "USER_SAVED_FIRST_PARTY_ARTIFACT",
              "EXPLICIT_OFFICIAL_EXPORT",
              "WRITTEN_PERMISSION"
            ]
          },
          "acquired_at": {"type": "string", "format": "date-time"},
          "original_filename": {"type": "string", "minLength": 1},
          "stored_relative_path": {"type": "string", "minLength": 3},
          "media_type": {"type": "string", "minLength": 3},
          "byte_size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rights_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis_type", "terms_or_permission_url", "local_evidence_relative_path", "summary"],
            "properties": {
              "basis_type": {
                "enum": [
                  "FIRST_PARTY_PUBLIC_RECORD_INTERNAL_RESEARCH",
                  "EXPLICIT_OFFICIAL_EXPORT_TERMS",
                  "WRITTEN_PERMISSION"
                ]
              },
              "terms_or_permission_url": {"type": ["string", "null"]},
              "local_evidence_relative_path": {"type": ["string", "null"]},
              "summary": {"type": "string", "minLength": 1}
            }
          },
          "redistribution_permitted": {"const": false},
          "contains_personal_data": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
