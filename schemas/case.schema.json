{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISI Case V1", "type": "object", "additionalProperties": false,
  "required": ["case_id", "ground_truth_status", "label_confidence", "primary_subtype", "review_status", "created_at", "updated_at"],
  "properties": {
    "case_id": {"type":"string","pattern":"^CASE_[A-Z0-9_-]+$"},
    "ground_truth_status": {"enum":["CONFIRMED","LEGITIMATE","UNCERTAIN"]},
    "label_confidence": {"enum":["HIGH","MEDIUM","LOW"]},
    "primary_subtype": {"type":["string","null"]},
    "secondary_tactics": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "campaign_id": {"type":["string","null"]}, "entity_cluster_id": {"type":["string","null"]},
    "review_status": {"enum":["UNREVIEWED","IN_REVIEW","REVIEWED","RECONCILED"]},
    "review_rationale": {"type":["string","null"]},
    "created_at": {"type":"string","format":"date-time"}, "updated_at": {"type":"string","format":"date-time"}
  }
}
