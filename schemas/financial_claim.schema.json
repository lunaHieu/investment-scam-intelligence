{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISI Financial Claim V1", "type": "object", "additionalProperties": false,
  "required": ["claim_id", "artifact_id", "claim_type", "extraction_method", "extractor_confidence"],
  "properties": {
    "claim_id": {"type":"string","pattern":"^CLM_[A-Z0-9_-]+$"}, "artifact_id": {"type":"string"},
    "claim_type": {"enum":["INITIAL_CAPITAL","PROMISED_RETURN","CLAIMED_PROFIT","DURATION","ROI","INTEREST_RATE","GUARANTEED_RETURN","CAPITAL_PROTECTION","RISK_FREE","URGENCY","SCARCITY","DEPOSIT_REQUEST","ADDITIONAL_DEPOSIT","WITHDRAWAL_FEE","PAYMENT_METHOD"]},
    "value_numeric": {"type":["number","null"]}, "currency": {"type":["string","null"]}, "value_text": {"type":["string","null"]}, "normalized_unit": {"type":["string","null"]}, "evidence_span": {"type":["string","null"]},
    "extraction_method": {"enum":["RULE","NER","HUMAN","HYBRID"]}, "extractor_confidence": {"type":"number","minimum":0,"maximum":1}, "human_verified": {"type":"boolean"}
  }
}
