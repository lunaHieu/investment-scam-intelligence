  "target_task": {
    "research_question": "Does the observed text of an investment solicitation, message, post, or website artifact exhibit risk patterns associated with an evidence-backed confirmed case rather than an evidence-backed legitimate identity/content case?",
    "prediction_unit": "ARTIFACT_WITH_CASE_LEVEL_GROUND_TRUTH",
    "positive_target": {
      "binary_label": 1,
      "required_case_status": "CONFIRMED",
      "semantics": "Observed investment-related artifact is directly linked to a case supported by reviewed evidence of an unauthorized, deceptive, impersonating, or fraudulent solicitation/operation.",
      "not_equivalent_to": [
        "legal conviction in every case",
        "presence on any warning list without identity linkage",
        "generic spam, phishing, bot, or fake-profile status"
      ]
    },
    "negative_target": {
      "binary_label": 0,
      "required_case_status": "LEGITIMATE",
      "semantics": "Observed artifact identity and content context are linked to an official or otherwise high-confidence legitimate entity/reference with no unresolved impersonation contradiction at review time.",
      "not_equivalent_to": [
        "absence from a warning list",
        "permanent safety guarantee",
        "registration alone without exact artifact identity matching"
      ]
    },
    "uncertain_policy": "UNCERTAIN records are retained with provenance but excluded from binary fitting, model selection, thresholding, and headline evaluation.",
    "allowed_artifact_types": [
      "POST",
      "MESSAGE",
      "WEBSITE_SNAPSHOT"
    ],
    "prohibited_as_predictive_input": [
      "WARNING_DOCUMENT",
      "COMPLAINT",
      "review rationale",
      "ground-truth status",
      "label confidence",
      "source ID",
      "evidence type",
      "verification status"
    ],
    "claim_limit": "The output is a research risk score for the defined artifact task, not a legal finding, investment recommendation, or universal scam probability."
  },
  "eligibility_contract": {
    "observed_artifact_required": true,
    "minimum_non_whitespace_text_characters": 20,
